{
  "globs": ["**/*.md"],
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD033": false,
    "MD034": false,
    "MD041": false,
  },
  "ignores": [
    ".claude/skills/**",
    "vendor/**",
    "node_modules/**",
    "docs/.vitepress/dist/**",
    "docs/.vitepress/cache/**",
    "tests/fixtures/invalid/**",
    "internal/**",
  ],
}
