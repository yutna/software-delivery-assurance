{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/software-delivery-assurance/schemas/profile.schema.json",
  "title": "SRAS assessment profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "version",
    "statuses",
    "maturity_levels",
    "weighted_index",
    "evidence_coverage",
    "gate_report",
    "status",
    "review_status",
    "translation_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "enum": ["lite", "full"]
    },
    "title": {
      "$ref": "requirement.schema.json#/$defs/localizedTitle"
    },
    "description": {
      "$ref": "requirement.schema.json#/$defs/localizedText"
    },
    "version": {
      "$ref": "requirement.schema.json#/$defs/semver"
    },
    "statuses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "not_assessed",
          "gap",
          "partial",
          "implemented",
          "verified",
          "not_applicable"
        ]
      }
    },
    "maturity_levels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["L0", "L1", "L2", "L3", "L4"]
      }
    },
    "weighted_index": {
      "type": "boolean"
    },
    "evidence_coverage": {
      "type": "boolean"
    },
    "gate_report": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "deprecated_in": {
      "anyOf": [
        {
          "$ref": "requirement.schema.json#/$defs/semver"
        },
        {
          "type": "null"
        }
      ]
    },
    "translation_status": {
      "type": "string",
      "enum": ["complete", "partial", "missing"]
    },
    "machine_translated": {
      "type": "boolean"
    },
    "translation_reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "translation_reviewed_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "unverified", "reviewed"]
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_scope": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "updated_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "reviewed",
            "type": "string"
          }
        },
        "required": ["review_status"],
        "type": "object"
      },
      "then": {
        "required": ["reviewed_by", "reviewed_at", "review_scope"],
        "properties": {
          "reviewed_by": {},
          "reviewed_at": {},
          "review_scope": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "translation_status": {
            "const": "complete",
            "type": "string"
          }
        },
        "required": ["translation_status"],
        "type": "object"
      },
      "then": {
        "required": ["translation_reviewed_by", "translation_reviewed_at"],
        "properties": {
          "description": {
            "properties": {
              "th": {
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "translation_reviewed_by": {},
          "translation_reviewed_at": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated",
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "then": {
        "properties": {
          "deprecated_in": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  ]
}
