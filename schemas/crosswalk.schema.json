{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/software-delivery-assurance/schemas/crosswalk.schema.json",
  "title": "SRAS crosswalk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "version",
    "source_standard",
    "source_url",
    "mappings",
    "status",
    "review_status",
    "translation_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^MAP-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "title": {
      "$ref": "requirement.schema.json#/$defs/localizedTitle"
    },
    "description": {
      "$ref": "requirement.schema.json#/$defs/localizedText"
    },
    "version": {
      "$ref": "requirement.schema.json#/$defs/semver"
    },
    "source_standard": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/crosswalkMapping"
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },
    "deprecated_in": {
      "anyOf": [
        {
          "$ref": "requirement.schema.json#/$defs/semver"
        },
        {
          "type": "null"
        }
      ]
    },
    "replaced_by": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^MAP-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "translation_status": {
      "type": "string",
      "enum": ["complete", "partial", "missing"]
    },
    "machine_translated": {
      "type": "boolean"
    },
    "translation_reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "translation_reviewed_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "unverified", "reviewed"]
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_scope": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "updated_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "reviewed",
            "type": "string"
          }
        },
        "required": ["review_status"],
        "type": "object"
      },
      "then": {
        "required": ["reviewed_by", "reviewed_at", "review_scope"],
        "properties": {
          "reviewed_by": {},
          "reviewed_at": {},
          "review_scope": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "translation_status": {
            "const": "complete",
            "type": "string"
          }
        },
        "required": ["translation_status"],
        "type": "object"
      },
      "then": {
        "required": ["translation_reviewed_by", "translation_reviewed_at"],
        "properties": {
          "title": {
            "properties": {
              "th": {
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "description": {
            "properties": {
              "th": {
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "translation_reviewed_by": {},
          "translation_reviewed_at": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deprecated",
            "type": "string"
          }
        },
        "required": ["status"],
        "type": "object"
      },
      "then": {
        "properties": {
          "deprecated_in": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "crosswalkMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "external", "relationship"],
      "properties": {
        "requirement": {
          "$ref": "requirement.schema.json#/$defs/requirementId"
        },
        "external": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "relationship": {
          "type": "string",
          "enum": ["supports", "partial", "related"]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
