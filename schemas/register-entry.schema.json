{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/software-delivery-assurance/schemas/register-entry.schema.json",
  "title": "SRAS regulatory register entry",
  "description": "A factual index entry for a law, regulation, standard, or guidance. A register entry is not an overlay and not legal advice.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jurisdiction",
    "instrument",
    "instrument_type",
    "regulator",
    "source_url",
    "effective_date",
    "revision",
    "last_verified",
    "review_due",
    "status",
    "summary",
    "obligations",
    "mapped_requirements",
    "applies_to",
    "notes",
    "source_language",
    "translation_status",
    "review_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2,5}-[A-Z]+-\\d{3}$"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}$|^ASEAN$|^EU$"
    },
    "instrument": {
      "type": "string",
      "minLength": 1
    },
    "instrument_type": {
      "type": "string",
      "enum": ["law", "regulation", "standard", "guidance", "framework"]
    },
    "regulator": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "effective_date": {
      "anyOf": [
        {
          "$ref": "requirement.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.r[1-9]\\d*$"
    },
    "last_verified": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_due": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "status": {
      "type": "string",
      "enum": ["in_force", "amended", "repealed", "draft", "unknown"]
    },
    "summary": {
      "$ref": "requirement.schema.json#/$defs/localizedText"
    },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/obligation"
      }
    },
    "mapped_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "requirement.schema.json#/$defs/requirementId"
      }
    },
    "applies_to": {
      "$ref": "#/$defs/appliesTo"
    },
    "notes": {
      "$ref": "requirement.schema.json#/$defs/localizedText"
    },
    "source_language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"
    },
    "translation_status": {
      "type": "string",
      "enum": ["complete", "partial", "missing"]
    },
    "machine_translated": {
      "type": "boolean"
    },
    "translation_reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "translation_reviewed_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_status": {
      "type": "string",
      "enum": ["draft", "unverified", "reviewed"]
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "$ref": "requirement.schema.json#/$defs/date"
    },
    "review_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "reviewed",
            "type": "string"
          }
        },
        "required": ["review_status"],
        "type": "object"
      },
      "then": {
        "required": ["reviewed_by", "reviewed_at", "review_scope"],
        "properties": {
          "reviewed_by": {},
          "reviewed_at": {},
          "review_scope": {}
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "translation_status": {
            "const": "complete",
            "type": "string"
          }
        },
        "required": ["translation_status"],
        "type": "object"
      },
      "then": {
        "required": ["translation_reviewed_by", "translation_reviewed_at"],
        "properties": {
          "summary": {
            "properties": {
              "th": {
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "notes": {
            "properties": {
              "th": {
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "translation_reviewed_by": {},
          "translation_reviewed_at": {}
        },
        "type": "object"
      }
    }
  ],
  "$defs": {
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "th"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "th": {
          "type": "string"
        }
      }
    },
    "appliesTo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectors", "roles", "data_types"],
      "properties": {
        "sectors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["finance", "ecommerce", "logistics", "public-sector"]
          }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "data_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
